{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "command": "./hooks/auto_learn_hook.sh --runtime cursor",
        "timeout": 15
      }
    ],
    "postToolUseFailure": [
      {
        "command": "./hooks/auto_learn_hook.sh --runtime cursor",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "./hooks/auto_learn_hook.sh --runtime cursor",
        "timeout": 15,
        "loop_limit": 1
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/auto_learn_hook.sh --runtime cursor",
        "timeout": 10
      }
    ]
  }
}
