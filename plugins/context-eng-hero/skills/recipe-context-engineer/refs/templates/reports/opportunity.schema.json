{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opportunity.schema.json",
  "title": "CE improve opportunity lean JSON",
  "type": "object",
  "required": ["target", "compliance_blockers", "ranked"],
  "additionalProperties": true,
  "properties": {
    "status": { "type": "string", "enum": ["ok", "partial", "failed"] },
    "clarifications": { "type": "array", "items": { "type": "string" } },
    "kind": { "const": "opportunity" },
    "target": {
      "type": "object",
      "required": ["path", "type"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }
      }
    },
    "compliance_blockers": { "type": "string" },
    "keep": { "type": "array", "items": { "type": "string" } },
    "challenge": { "type": "string" },
    "ranked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "id",
          "pattern",
          "impact",
          "confidence",
          "absorb",
          "summary"
        ],
        "additionalProperties": true,
        "properties": {
          "rank": { "type": ["integer", "string"] },
          "id": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string" },
          "stance": { "type": "string" },
          "impact": { "type": "string" },
          "confidence": { "type": "string" },
          "absorb": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "opportunity_detail": { "type": "string" },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "pattern": { "type": "string" },
          "impact": { "type": "string" },
          "confidence": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
