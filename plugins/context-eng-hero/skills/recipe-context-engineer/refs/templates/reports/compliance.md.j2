{# Compliance report — scaffolding only; findings come from lean JSON. #}
{%- macro sev_line(bucket) -%}
{%- if bucket -%}{{ bucket.pass | int }}/{{ bucket.total | int }}{%- else -%}0/0{%- endif -%}
{%- endmacro -%}
{%- set sev = severity or {} -%}
{%- set sum = summary or {} -%}
{%- set tgt = target or {} -%}
{%- set title = tgt.title or tgt.path -%}
{%- if sum.verdict == "FAIL" -%}
{%- set default_next = "FAIL: fix every FAIL in this report" -%}
{%- else -%}
{%- set default_next = "PASS: ship or run behavior test if unverified" -%}
{%- endif -%}
