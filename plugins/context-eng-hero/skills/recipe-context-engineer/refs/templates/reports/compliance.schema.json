{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compliance.schema.json",
  "title": "CE improve compliance lean JSON",
  "type": "object",
  "required": ["target", "summary", "severity", "checks"],
  "additionalProperties": true,
  "properties": {
    "status": { "type": "string", "enum": ["ok", "partial", "failed"] },
    "clarifications": { "type": "array", "items": { "type": "string" } },
    "kind": { "const": "compliance" },
    "target": {
      "type": "object",
      "required": ["path", "type"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["verdict", "static", "top_patterns"],
      "additionalProperties": true,
      "properties": {
        "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
        "static": { "type": "string", "minLength": 1 },
        "top_patterns": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "severity": {
      "type": "object",
      "required": ["critical", "major", "minor"],
      "additionalProperties": true,
      "properties": {
        "critical": { "$ref": "#/$defs/sev_bucket" },
        "major": { "$ref": "#/$defs/sev_bucket" },
        "minor": { "$ref": "#/$defs/sev_bucket" }
      }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check_row" }
    },
    "findings_narrative": { "type": "string" },
    "recommended_next": { "type": "string" }
  },
  "$defs": {
    "sev_bucket": {
      "type": "object",
      "required": ["pass", "total"],
      "additionalProperties": true,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "check_row": {
      "type": "object",
      "required": ["id", "severity", "result", "evidence"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string" },
        "result": { "type": "string" },
        "evidence": { "type": "string" }
      }
    }
  }
}
