{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rr-agentic-kit/ai-plugins/plugins/rrraw/refs/planning/schemas/items.schema.json",
  "title": "rr-planner item registry",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "parent", "kind", "spec", "priority_method"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(ES|MRD|BRD|PRD)-\\d+(\\.\\d+)?$"
        },
        "parent": {
          "type": ["string", "null"],
          "pattern": "^(ES|MRD|BRD|PRD)-\\d+(\\.\\d+)?$"
        },
        "kind": { "type": "string", "enum": ["container", "leaf"] },
        "spec": {
          "type": "string",
          "enum": ["idea", "draft", "ready", "deprecated"]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "goal_type": {
          "type": "string",
          "enum": ["primary", "support"]
        },
        "reach": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "enum": ["0.25", "0.5", "1", "2", "3"]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "effort": {
          "type": "string",
          "enum": ["1", "2", "3", "5", "8", "13"]
        },
        "supersedes": { "type": "string" },
        "superseded_by": { "type": "string" },
        "priority_method": {
          "type": "string",
          "enum": ["moscow", "kano", "rice"]
        },
        "moscow": {
          "type": ["string", "null"],
          "enum": ["Must", "Should", "Could", "Won't", null]
        },
        "kano": {
          "type": ["string", "null"],
          "enum": ["basic", "performance", "delighter", null]
        },
        "rationale": {
          "type": "string",
          "pattern": "^r-\\d{3,}$"
        },
        "title": { "type": "string" },
        "doc": {
          "type": "string",
          "enum": ["executive-summary", "mrd", "brd", "prd"]
        }
      }
    }
  }
}
