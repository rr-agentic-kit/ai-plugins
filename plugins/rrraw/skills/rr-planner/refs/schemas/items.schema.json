{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rr-agentic-kit/ai-plugins/plugins/rrraw/skills/rr-planner/refs/schemas/items.schema.json",
  "title": "rr-planner item registry",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "magnitude": {
      "type": "string",
      "enum": ["critical", "high", "moderate", "low"]
    },
    "axis": {
      "type": "object",
      "required": ["effect", "magnitude"],
      "additionalProperties": false,
      "properties": {
        "effect": { "type": "string", "minLength": 1 },
        "magnitude": { "$ref": "#/$defs/magnitude" }
      }
    },
    "triad": {
      "type": "object",
      "required": ["if_present", "if_absent", "if_wrong", "class"],
      "additionalProperties": false,
      "properties": {
        "if_present": { "$ref": "#/$defs/axis" },
        "if_absent": { "$ref": "#/$defs/axis" },
        "if_wrong": { "$ref": "#/$defs/axis" },
        "class": {
          "type": "string",
          "enum": ["must-correct", "must-present", "protect", "leverage", "optional"]
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "parent", "kind", "spec", "priority_method"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(ES|MRD|BRD|PRD|FRD)-\\d+(\\.\\d+)?$"
        },
        "parent": {
          "type": ["string", "null"],
          "pattern": "^(ES|MRD|BRD|PRD|FRD)-\\d+(\\.\\d+)?$"
        },
        "kind": { "type": "string", "enum": ["container", "leaf"] },
        "spec": {
          "type": "string",
          "enum": ["idea", "draft", "ready", "deprecated"]
        },
        "build": {
          "type": "string",
          "enum": ["none", "in_progress", "done"]
        },
        "supersedes": { "type": "string" },
        "superseded_by": { "type": "string" },
        "priority_method": {
          "type": "string",
          "enum": ["moscow", "kano", "triad"]
        },
        "moscow": {
          "type": ["string", "null"],
          "enum": ["Must", "Should", "Could", "Won't", null]
        },
        "kano": {
          "type": ["string", "null"],
          "enum": ["basic", "performance", "delighter", null]
        },
        "triad": { "$ref": "#/$defs/triad" },
        "title": { "type": "string" },
        "doc": {
          "type": "string",
          "enum": ["exec-summary", "mrd", "brd", "prd", "frd"]
        }
      }
    }
  }
}
